# ${project_name} — BOS project configuration (workspace archetype).
# Full commented reference: `boscli init --minimal` in an empty directory.
# purpose: ${purpose_comment}

[platform]
envfile = ".env"
# Python files under ./extensions are scanned for @ep_tool / @ep_channel / … registrations.
extensions = ["bos.exts", "./extensions"]
# .toml / .md files under ./agents define named agents (filename stem = agent name).
agent_dirs = ["./agents"]

[agent.defaults]
${model_line}

[agent.defaults.tools]
enabled = ["*"]

[agent.defaults.plugins]
enabled = ["*"]

[agents.main]
description = "Main agent for ${project_name}"
system_prompt = """
You are the main agent of this project.

Project purpose: ${purpose_toml}

Help the user accomplish this purpose. Use the available tools, skills, and
memory; keep answers concrete and grounded in what you can verify.
"""

[agents.main.plugin-bindings.SubagentPlugin]
enabled = ["*"]   # delegate to any named agent (e.g. bos_config) via AskSubagent

[runtime]
main_actor = "main"

[runtime.gateway]
# 0 = let the system assign a free port; clients discover it via gateway.state.
port = 0

[runtime.actors.main]
agent = "main"
display_name = "Main"

# ── Optional: narrow subagent delegation ──────────────────────────
# main can already delegate to any registered agent (e.g. the built-in
# bos_config) via AskSubagent, per the binding above. Add agents under
# ./agents (e.g. agents/researcher.md, agents/writer.md; filename stem =
# agent name) and list them explicitly to restrict the allow-list instead:
#
# [agents.main.plugin-bindings.SubagentPlugin]
# enabled = ["researcher", "writer"]
#
# To also reach a specialist directly (e.g. @researcher), give it its own actor:
# [runtime.actors.researcher]
# agent = "researcher"
# display_name = "Researcher"

# ── Optional: reach this agent over Telegram ─────────────────────
# Create a bot with @BotFather and put its token in .env as TELEGRAM_BOT_TOKEN,
# then uncomment the channel below and restart the gateway.
#
# [[runtime.channels]]
# type = "TelegramChannel"
# channel_id = "telegram+main"
# display_name = "Telegram"
# target_actor = "main"
# settings = { token_env = "TELEGRAM_BOT_TOKEN" }
