# ${project_name} — BOS project configuration (team archetype).
# Full commented reference: `boscli project init --minimal` in an empty directory.
# purpose: ${purpose_comment}

[platform]
envfile = ".env"
# Python files under ./extensions are scanned for @ep_tool / @ep_channel / … registrations.
extensions = ["bos.exts", "./extensions"]
# .toml / .md files under ./agents define named agents (filename stem = agent name).
# The two specialists below live there: agents/${specialist_a}.md, agents/${specialist_b}.md
agent_dirs = ["./agents"]

[agent.defaults]
${model_line}

[agent.defaults.tools]
enabled = ["*"]

[agent.defaults.plugins]
enabled = ["*"]

[agents.main]
description = "Coordinator agent for ${project_name}"
system_prompt = """
You are the coordinator agent of this project.

Project purpose: ${purpose_toml}

Delegate focused work to your specialist sub-agents with the AskSubagent tool
and assemble their results into the final answer. Specialists available:
${specialist_a}, ${specialist_b}.
"""

# Which sub-agents the coordinator may delegate to.
[agents.main.plugin-bindings.SubagentPlugin]
enabled = ["${specialist_a}", "${specialist_b}"]

[runtime]
location = "process"
default_actor = "main"

[runtime.gateway]
# 0 = let the system assign a free port; clients discover it via gateway.state.
port = 0

[runtime.actors.main]
agent = "main"
display_name = "Main"

# ${specialist_a} also runs as its own actor — message it directly with @${specialist_a}.
[runtime.actors.${specialist_a}]
agent = "${specialist_a}"
display_name = "${specialist_a_display}"
